{# NOVA_CUSTOM_COMPONENT_BRANCH #}
{% if component is defined and component.product_card_style is defined %}
<section data-testid="store-home-products-section" class="s-block s-block--latest-products container mt-6 sm:mt-8 nova-product-element nova-card-style-{{ component.product_card_style }}" data-nova-card-style="{{ component.product_card_style }}"><salla-products-list data-testid="store-home-latest-products-list" source="latest" limit="{{ component.limit|default(8) }}" product-card-component="custom-salla-product-card"></salla-products-list></section>
{% else %}
{#
| Variable        | Type       | Description                    |
|-----------------|------------|--------------------------------|
| products        | Products[] |                                |
| position        | Int        | Sorting number start from zero |
#}
<section data-testid="store-home-products-section" class="s-block s-block--latest-products container mt-6 sm:mt-8" data-nova-card-style="{{ theme.settings.get('product_card_style', 'modern') }}">
    <div class="s-block__title">
      <h2>{{ trans('blocks.home.latest_products') }}</h2>
    </div>
    
    <salla-products-list data-testid="store-home-latest-products-list" source="latest"
      product-card-component="custom-salla-product-card"
      {{ theme.settings.get('product_card_style') == 'horizontal' ? 'row-cards' : '' }}></salla-products-list>
</section> 

{% endif %}
