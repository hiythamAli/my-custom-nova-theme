{#
| Variable                           | Type     | Description                                                                  |
|------------------------------------|----------|------------------------------------------------------------------------------|
| component                          | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.merge_with_top_component | bool     |                                                                              |
| component.title                    | ?string  |                                                                              |
| component.links                    | object[] | list of links                                                                |
| position                           | int      | Sorting number start from zero                                               |
#}
{% set display_mode = theme.settings.get('nova_categories_display', 'grid') %}
<section data-testid="store-home-main-links" class="s-block s-block--categories nova-quick-links nova-cats--{{ display_mode }} {{ component.merge_with_top_component and position ?'merge-with-top-component' : '' }} {{ not component.title and component.merge_with_top_component ? 'merged-has-no-title' : '' }}">
    {% if component.title %}
        <div class="container"><div class="s-block__title"><div class="right-side"><h2>{{ component.title }}</h2></div></div></div>
    {% endif %}

    {% if display_mode == 'marquee' %}
        {# Continuous CSS marquee — plain divs, no swiper/JS dependency,
           content duplicated (group 1 + group 2) for a seamless loop. #}
        <div class="nova-cat-marquee">
            <div class="nova-cat-marquee__track">
                {% for i in 1..2 %}
                    <div class="nova-cat-marquee__group">
                        {% if component.show_cats %}
                            {% for cat in component.categories %}
                                <div class="nova-cat-marquee__item">
                                    <a href="{{ cat.url }}" class="slide--cat-entry">
                                        {% if cat.image %}
                                          <img src="{{ cat.image ? cat.image : 'images/placeholder.png' | asset }}" width="120" height="120" alt="{{ cat.name }}"/>
                                        {% else %}
                                          <i class="{{ cat.icon }}"></i>
                                        {% endif %}
                                        <h2>{{ cat.name }}</h2>
                                    </a>
                                </div>
                            {% endfor %}
                        {% else %}
                            {% for link in component.links %}
                                {% if link.title %}
                                    <div class="nova-cat-marquee__item">
                                        <a href="{{ link.url }}" class="slide--cat-entry">
                                            <i class="{{ link.icon }}"></i>
                                            <h2>{{ link.title }}</h2>
                                        </a>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        {# Static grid — no animation, no swiper dependency #}
        <div class="container">
            <div class="nova-cat-grid">
                {% if component.show_cats %}
                    {% for cat in component.categories %}
                        <a href="{{ cat.url }}" class="slide--cat-entry">
                            {% if cat.image %}
                              <img src="{{ cat.image ? cat.image : 'images/placeholder.png' | asset }}" width="120" height="120" alt="{{ cat.name }}"/>
                            {% else %}
                              <i class="{{ cat.icon }}"></i>
                            {% endif %}
                            <h2>{{ cat.name }}</h2>
                        </a>
                    {% endfor %}
                {% else %}
                    {% for link in component.links %}
                        {% if link.title %}
                            <a href="{{ link.url }}" class="slide--cat-entry">
                                <i class="{{ link.icon }}"></i>
                                <h2>{{ link.title }}</h2>
                            </a>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    {% endif %}
</section>
