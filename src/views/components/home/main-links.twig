{#
| Variable                           | Type     | Description                                                                  |
|-------------------------------------|----------|-------------------------------------------------------------------------------|
| component                          | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.merge_with_top_component | bool     |                                                                                |
| component.title                    | ?string  |                                                                                |
| component.show_cats                | bool     |                                                                                |
| component.categories               | object[] |                                                                                |
| component.links                    | object[] | list of links                                                                  |
| component.layout                   | string   | grid / marquee                                                                 |
| component.image_size               | string   | natural / small                                                                |
| component.show_cat_titles           | bool     | show / hide category titles                                                    |
| position                           | int      | Sorting number start from zero                                                |
#}

{% set items = component.show_cats ? component.categories : component.links %}
{% set section_classes = component.layout == 'marquee' ? 'nova-quick-links--marquee' : 'nova-quick-links--grid' %}
{% set section_classes = section_classes ~ (component.image_size == 'small' ? ' nova-quick-links--small-images' : 'nova-quick-links--natural-images') %}
{% set hide_cat_titles = component.show_cats and component.show_cat_titles is defined and component.show_cat_titles == false %}
{% set section_classes = section_classes ~ (hide_cat_titles ? ' nova-quick-links--hide-titles' : '') %}

<section data-testid="store-home-main-links"
         class="s-block s-block--categories nova-quick-links {{ section_classes }} {{ component.merge_with_top_component and position ? 'merge-with-top-component' : '' }} {{ not component.title and component.merge_with_top_component ? 'merged-has-no-title' : '' }}">
    <div class="container">
        {% if component.title %}
            <div class="s-block__title">
                <div class="right-side">
                    <h2>{{ (component.title is iterable ? component.title[language.code]|default(component.title|first) : component.title) }}</h2>
                </div>
            </div>
        {% endif %}

        {% if component.layout == 'marquee' %}
            <div class="nova-quick-links__viewport" aria-label="{{ component.title|default('التصنيفات') }}">
                <div class="nova-quick-links__track">
                    {% for group in 1..2 %}
                        <div class="nova-quick-links__group" aria-hidden="{{ group == 2 ? 'true' : 'false' }}">
                            {% for item in items %}
                                {% if component.show_cats or item.title %}
                                    <a href="{{ item.url }}" class="slide--cat-entry nova-quick-links__item">
                                        {% if item.image %}
                                            <img src="{{ item.image }}" alt="{{ item.name|default(item.title) }}" />
                                        {% elseif item.icon %}
                                            <i class="{{ item.icon }}"></i>
                                        {% endif %}
                                        {% if not component.show_cats or not hide_cat_titles %}
                                            <h2>{{ item.name|default(item.title) }}</h2>
                                        {% endif %}
                                    </a>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="nova-quick-links__grid">
                {% for item in items %}
                    {% if component.show_cats or item.title %}
                        <a href="{{ item.url }}" class="slide--cat-entry nova-quick-links__item">
                            {% if item.image %}
                                <img src="{{ item.image }}" alt="{{ item.name|default(item.title) }}" />
                            {% elseif item.icon %}
                                <i class="{{ item.icon }}"></i>
                            {% endif %}
                            {% if not component.show_cats or not hide_cat_titles %}
                                <h2>{{ item.name|default(item.title) }}</h2>
                            {% endif %}
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
