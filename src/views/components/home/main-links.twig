{#
| Variable                    | Type     | Description |
|-----------------------------|----------|-------------|
| component                   | object   | Main links component |
| component.title             | ?string  | Section title |
| component.links             | object[] | Custom links |
| component.categories        | object[] | Selected categories |
| component.show_cats         | bool     | Show categories |
| component.nova_display_mode | string   | grid / marquee |
| component.nova_image_size   | string   | normal / small |
| component.nova_show_border  | bool     | Show card background/border |
| position                    | int      | Component position |
#}

{% set display_mode = component.nova_display_mode|default('grid') %}
{% set image_size = component.nova_image_size|default('normal') %}
{% set show_border = component.nova_show_border|default(false) ? 'bordered' : 'borderless' %}

<section
    component-id="{{ componentId }}"
    data-testid="store-home-main-links"
    class="s-block s-block--categories nova-quick-links nova-cats--{{ display_mode }} nova-cats-size--{{ image_size }} nova-cats-border--{{ show_border }} {{ component.merge_with_top_component and position ? 'merge-with-top-component' : '' }} {{ not component.title and component.merge_with_top_component ? 'merged-has-no-title' : '' }}"
>
    {% if component.title %}
        <div class="container">
            <div class="s-block__title">
                <div class="right-side">
                    <h2>{{ component.title }}</h2>
                </div>
            </div>
        </div>
    {% endif %}

    {% if component.show_cats and component.categories %}

        {% if display_mode == 'marquee' %}
            <div class="nova-cat-marquee" dir="ltr">
                <div class="nova-cat-marquee__track">
                    {% for copy in 1..2 %}
                        <div class="nova-cat-marquee__group">
                            {% for cat in component.categories %}
                                <a href="{{ cat.url }}" class="slide--cat-entry" aria-label="{{ cat.name }}">
                                    {% if cat.image %}
                                        <img src="{{ cat.image }}" width="120" height="120" alt="{{ cat.name }}" loading="lazy">
                                    {% elseif cat.icon %}
                                        <i class="{{ cat.icon }}" aria-hidden="true"></i>
                                    {% endif %}
                                    <h2>{{ cat.name }}</h2>
                                </a>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="container">
                <div class="nova-cat-grid">
                    {% for cat in component.categories %}
                        <a href="{{ cat.url }}" class="slide--cat-entry" aria-label="{{ cat.name }}">
                            {% if cat.image %}
                                <img src="{{ cat.image }}" width="120" height="120" alt="{{ cat.name }}" loading="lazy">
                            {% elseif cat.icon %}
                                <i class="{{ cat.icon }}" aria-hidden="true"></i>
                            {% endif %}
                            <h2>{{ cat.name }}</h2>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    {% else %}

        {# Original Quick Links fallback when categories are disabled/not selected #}
        {% if component.links %}
            {% if display_mode == 'marquee' %}
                <div class="nova-cat-marquee" dir="ltr">
                    <div class="nova-cat-marquee__track">
                        {% for copy in 1..2 %}
                            <div class="nova-cat-marquee__group">
                                {% for link in component.links %}
                                    {% if link.title %}
                                        <a href="{{ link.url }}" class="slide--cat-entry" aria-label="{{ link.title }}">
                                            <i class="{{ link.icon }}" aria-hidden="true"></i>
                                            <h2>{{ link.title }}</h2>
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="container">
                    <div class="nova-cat-grid">
                        {% for link in component.links %}
                            {% if link.title %}
                                <a href="{{ link.url }}" class="slide--cat-entry" aria-label="{{ link.title }}">
                                    <i class="{{ link.icon }}" aria-hidden="true"></i>
                                    <h2>{{ link.title }}</h2>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endif %}

    {% endif %}
</section>
