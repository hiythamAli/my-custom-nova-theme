{#
| Variable      | Type   | Description                                                      |
|---------------|--------|------------------------------------------------------------------|
| items[]       | array  | List of 3 features                                               |
| items[].icon  | string | SallaIcons css class `sicon-*`                                   |
| items[].title | string | Title of the feature                                             |
| items[].text  | string | Subtitle for the feature                                         |
| position      | Int    | Sorting number start from zero                                   |
#}
<section data-testid="store-home-features" class="s-block s-block--features nova-features-marquee">
    <div class="nova-marquee">
      <div class="nova-marquee__track">
        {% for i in 1..2 %}
          <div class="nova-marquee__group">
            {% for item in items %}
              <div class="s-block--features__item">
                <div class="feature-icon">
                  <i class="{{ item.icon }}"></i>
                </div>
                <h2>{{ item.title }}</h2>
                <p>{{ item.text }}</p>
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
</section>