{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides[].button_text | ?string  | Nova: optional CTA label, hidden if empty                                    |
| component.slides[].button_url  | ?string  | Nova: optional CTA link, hidden if empty                                     |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
{% set hero_style = theme.settings.get('hero_style', 'editorial') %}
<section data-testid="store-home-slider" class="s-block s-block--hero-slider s-block--full-bg wide-placeholder nova-hero nova-hero--{{ hero_style }}">
    <salla-slider 
      id="main-slider-{{ position }}"
      auto-play
      static-when-single
      slider-config='{"lazy":"false"}'
      {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
      type="fullwidth">
        <div slot="items">
            {% for slide in component.slides %}
                <div class="swiper-slide w-full min-h-[300px] lg:min-h-[528px] bg-dark relative nova-hero-slide">
					<div style="background-image: url({{ slide.image }});" class="{{ slide.without_overlay ? '' : 'overlay-bg' }} bg-cover bg-center absolute inset-0 nova-hero-slide__bg"></div>
                    <div class="flex-center container pb-16 sm:pb-0 home-slider__content relative h-full">
                        <div class="nova-hero-slide__copy w-4/6 text-center md:w-7/12 lg:w-5/12 text-white">
                            <h2 data-swiper-parallax="-500" class="lg:text-title-size font-bold leading-tight mb-4">{{ slide.title }}</h2>
                            <p data-swiper-parallax="-300" class="line-clamp-2 description">{{ slide.description }}</p>
                            {% if slide.button_text %}
                                <a href="{{ slide.button_url|default('#') }}" data-swiper-parallax="-200" class="nova-hero-slide__btn">{{ slide.button_text }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section> 
