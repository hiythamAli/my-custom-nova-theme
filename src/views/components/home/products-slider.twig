{# NOVA_CUSTOM_COMPONENT_BRANCH #}
{% if component is defined and component.product_card_style is defined %}
<section class="s-block s-block--best-offers container overflow-hidden nova-product-element nova-card-style-{{ component.product_card_style }}" data-nova-card-style="{{ component.product_card_style }}"><salla-products-slider source="selected" source-value="{{ component.products|map(p => p.id)|json_encode }}" limit="{{ component.products|length }}" product-card-component="custom-salla-product-card"></salla-products-slider></section>
{% else %}
{#
| Variable              | Type      | Description                                                      |
|-----------------------|-----------|------------------------------------------------------------------|
| products.source       | string    |                                                                  |
| products.source_value | ?int[]    | ids of sources (product_ids, categories_ids, brands_id..etc)     |
| products.source_value | ?int      | limit of products                                                |
| title                 | string    | Section title                                                    |
| display_all_url       | ?string   | If it's existed, mean should show load more link to this url     |
| position              | Int       | Sorting number start from zero                                   |
| limit                 | int       | Number of products to be shown                                   |
#}

<section data-testid="store-home-products-slider" id="best-offers-{{ position }}-slider" class="s-block s-block--best-offers container overflow-hidden" data-nova-card-style="{{ theme.settings.get('product_card_style', 'modern') }}">
  {% if products|length %}
    <salla-products-slider
            data-testid="store-home-products-slider-widget"
            source="{{ products.source }}"
            limit="{{ limit }}"
            autoplay
            source-value="{{ products.source_value|json_encode }}"
            display-all-url="{{display_all_url}}"
            block-title="{{ title }}"
            block-subTitle="{{ sub_title|raw }}"
            slider-id="slider-with-bg-{{ position }}"
            product-card-component="custom-salla-product-card"
    ></salla-products-slider>
  {% endif %}
</section>

{% endif %}
